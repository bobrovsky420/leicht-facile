# Copy to .env and fill in. `make run` needs at least the first three variables,
# here or in the shell (a value in the shell wins). Never commit .env.

# --- Model endpoint (OpenAI-compatible) -------------------------------------------
# Profile A (default): CSCS inference API, as provided for the hackathon.
# Thinking models are separate model names ending in "-thinking".
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_JUDGE_NAME=swiss-ai/Apertus-v1.5-70B
LLM_THINKING_MODE=model-suffix
# CSCS closes about one long thinking stream in four midway (checked 6 October 2026);
# the client retries, and 8 attempts make a hard failure rare.
LLM_MAX_RETRIES=8
# Model tiers (track_2b/eval/report.md compares them on the held-out pairs):
# - default: the 8B reads, writes and repairs, the 70B-thinking judges (one GPU on-premise).
# - quality: LLM_NAME=swiss-ai/Apertus-v1.5-70B runs every stage on the 70B (cleaner style,
#   fewer facts kept, about twice the price per page; the judge then grades its own drafts).
# - hybrid: LLM_UNDERSTAND_NAME=swiss-ai/Apertus-v1.5-70B lets the 70B read and the 8B
#   write (tested: it kept the fewest facts, track_2b/docs/prompts.md).

# Profile B: local vLLM (docker compose --profile local-llm up), on-premise or
# air-gapped. One server; thinking is switched per request.
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_API_KEY=local
# LLM_NAME=swiss-ai/Apertus-v1.5-8B
# LLM_JUDGE_NAME=swiss-ai/Apertus-v1.5-8B
# LLM_THINKING_MODE=chat-template
# HF_TOKEN=             # to download the weights on first start

# Profile C: Public AI gateway, for development and evaluation with public documents.
# Pay per token after USD 2 of starter credit; key from platform.publicai.co.
# Run by Metagov Inc. (US nonprofit); requests are routed to compute partners. Not a
# sovereign deployment: never use it for documents with personal data.
# Checked on 6 October 2026 (response headers name the backend of each model):
# - apertus-v1.5-8b goes to Juelich (Blablador, vLLM) and thinks when asked through
#   the chat template, hence LLM_THINKING_MODE=chat-template. Unreliable: about one
#   call in three answers without reasoning, with identical requests. Fine for
#   development; thinking vs. no-thinking comparisons need the CSCS endpoint.
# - apertus-v1.5-70b goes to Infomaniak (Apertus-v1.5-70B) and ignores the thinking
#   switch, so the 70B judge always runs without thinking.
# - Do not use the "-thinking" names: apertus-v1.5-8b-thinking serves the older
#   Apertus 1 (Apertus-8B-Instruct-2509, Featherless) without thinking.
# - The gateway caches responses without regard to the thinking switch; the extra
#   body turns its cache off.
# LLM_BASE_URL=https://api.publicai.co/v1
# LLM_API_KEY=
# LLM_NAME=swiss-ai/apertus-v1.5-8b
# LLM_JUDGE_NAME=swiss-ai/apertus-v1.5-70b
# LLM_THINKING_MODE=chat-template
# LLM_EXTRA_BODY={"cache": {"no-cache": true}}

# Profile D: Hugging Face inference router, for development only.
# Serves the older Apertus 1 (2509) models, not 1.5, through third-party providers
# outside Switzerland. Never use it for real documents, and do not report its
# results as Apertus 1.5 numbers.
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...
# LLM_NAME=swiss-ai/Apertus-8B-Instruct-2509:publicai
# LLM_JUDGE_NAME=swiss-ai/Apertus-70B-Instruct-2509:featherless-ai
# LLM_THINKING_MODE=off

# Profile E: local llama.cpp server, for development and small offices without a key.
# Runs Apertus v1.5 8B on an 8 GB GPU with a community 4-bit text-only conversion
# (unofficial; no image input). Start the server on the host, for example:
#   llama-server -hf Colby/apertus-v1.5-8b-text-Q4_K_M-GGUF -ngl 99 -c 16384 -fa on \
#     -ctk q8_0 -ctv q8_0 --jinja -sp -np 1 --alias apertus-v1.5-8b-q4-llamacpp --port 8080
# -sp keeps the reasoning markers visible so the client can strip the reasoning.
# The alias names what runs, so results from this setup are never mistaken for the
# official model on CSCS.
# From the container use http://host.docker.internal:8080/v1 (start the server with
# --host 0.0.0.0); from the host use http://127.0.0.1:8080/v1.
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=local
# LLM_NAME=apertus-v1.5-8b-q4-llamacpp
# LLM_THINKING_MODE=chat-template
# LLM_TIMEOUT_S=1800       # thinking calls take minutes on a laptop GPU

# --- Optional -----------------------------------------------------------------------
# LLM_STREAM=1           # 0 turns streaming off (only for a server that cannot stream)
# LLM_TIMEOUT_S=300
# LLM_MAX_RETRIES=8
# LLM_CACHE=0            # 1 caches responses in DATA_DIR (development, evaluation)
# LLM_EXTRA_BODY={}      # JSON fields sent with every request (gateway switches)
# LLM_THINKING_STAGES=understand,judge   # stages that use the thinking model
# LLM_UNDERSTAND_NAME=swiss-ai/Apertus-v1.5-70B   # the hybrid: the 70B reads, the 8B writes
# ALLOW_PRIVATE_URLS=0   # 1 lets users submit URLs of the internal network (intranet only)
# MAX_REPAIR_ROUNDS=3
# MAX_FACTS_ROUNDS=1     # rounds for the missing facts alone after the repair loop; 0 off
# MAX_MISSING_PER_FACTS_ROUND=10  # facts one such round asks for (a repair round asks for 5)
# MAX_RECOVER_FACTS=10   # missing values asked for one by one with their paragraph after the facts rounds; 0 off
# USE_VOCABULARY=1       # 0 leaves the vocabulary of hard words out (only to measure it)
# UI_LANG=auto          # interface language: auto (browser), en or de
# LOG_LEVEL=INFO         # document text is only ever logged at DEBUG

# --- Jobs and data (track_2b/docs/architecture.md §7 and §10) ---------------------------
# JOB_WORKERS=1          # threads that run jobs; more than 1 needs an endpoint that serves
#                        # parallel requests (vLLM does)
# JOB_QUEUE_LIMIT=50     # jobs that may wait; a submission beyond it gets 429
# JOB_TIME_BUDGET_S=7200 # a job running longer is stopped and keeps its finished stages; 0 off
# INGEST_SLOTS=4         # submissions read (fetched, parsed, segmented) at once; beyond it 429
# DATA_RETENTION_DAYS=0  # jobs older than this are deleted every hour, their cache rows
#                        # included; the example jobs stay; 0 keeps everything

# --- Deployment (track_2b/docs/architecture.md §10) ---------------------------------
# BIND_HOST=127.0.0.1    # the interface Compose publishes port 8000 on; 0.0.0.0 for every
#                        # interface, which needs one of the two logins below
# AUTH_TOKEN=            # a shared secret: the browser asks for it (any user name, the
#                        # token as the password); scripts send "Authorization: Bearer <token>"
# AUTH_PROXY_HEADER=     # or trust the reverse proxy's user header (X-Forwarded-User, Remote-User) ...
# AUTH_PROXY_FROM=       # ... from these addresses or networks only, comma-separated (172.16.0.0/12)
# RATE_LIMIT_PER_MINUTE=120  # writes (POST, PUT, PATCH, DELETE) per client address and minute; 0 off
