    "/api/v1/jobs/{job_id}/facts/{fact_id}/recover": {
      "post": {
        "summary": "Recover",
        "description": "Sentences for a missing fact from its source paragraph, one writer call\n(stages.recover_fact). Nothing is stored but the call's usage: the reviewer adds the\nsentences to a block, as an edit, or leaves them. The rule findings come in the\ninterface language.",
        "operationId": "recover_api_v1_jobs__job_id__facts__fact_id__recover_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
