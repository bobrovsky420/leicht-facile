    "/api/v1/jobs/{job_id}/export": {
      "post": {
        "summary": "Export",
        "description": "`original` appends the source text to Markdown, HTML and Word; the audit bundle\nholds it anyway. The bundle names the user who exported it, the Word footer the\nusers who decided (web/security.py).",
